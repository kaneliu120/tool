{
  "actorSpecification": 1,
  "name": "google-play-scraper",
  "title": "Google Play Scraper",
  "description": "Scrape Google Play search, categories, app details, developer pages, and data-safety summaries via a Cloud Run worker. Package id is the primary key. Does not invent app ids or scrape review bodies.",
  "version": "0.0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "input": "./.actor/input_schema.json",
  "storages": {
    "dataset": "./.actor/dataset_schema.json"
  },
  "usesStandbyMode": true,
  "webServerSchema": "./.actor/openapi.json",
  "defaultRunOptions": {
    "build": "latest",
    "timeoutSecs": 3600,
    "memoryMbytes": 1024
  },
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 4096,
  "environmentVariables": {
    "WORKER_BASE_URL": {
      "description": "Cloud Run worker origin (https://*.run.app)",
      "value": "",
      "isSecret": false
    },
    "WORKER_AUTH": {
      "description": "Worker API key (Bearer / X-Api-Key)",
      "value": "",
      "isSecret": true
    },
    "WORKER_PROVIDES_PROXY": {
      "description": "Worker owns egress; do not mint Apify RESIDENTIAL",
      "value": "1",
      "isSecret": false
    }
  }
}
