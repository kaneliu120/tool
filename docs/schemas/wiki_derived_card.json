{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendata.best/schemas/wiki_derived_card.json",
  "title": "Mem0 wiki.derived card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "layer",
    "repo",
    "commit_sha",
    "cites",
    "text",
    "embed_model"
  ],
  "properties": {
    "kind": { "const": "wiki.derived" },
    "layer": { "enum": ["overview", "module", "flow"] },
    "repo": { "type": "string", "minLength": 1 },
    "commit_sha": { "type": "string", "minLength": 7 },
    "cites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "start", "end", "sha256", "source_text"],
        "properties": {
          "path": { "type": "string" },
          "start": { "type": "integer", "minimum": 1 },
          "end": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string" },
          "source_text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 800 },
    "valid_from": { "type": ["string", "null"] },
    "valid_to": { "type": ["string", "null"] },
    "embed_model": { "const": "voyage-4-large" }
  }
}
