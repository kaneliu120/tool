{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendata.best/schemas/code_l1_chunk.json",
  "title": "Mem0 code L1 chunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "repo",
    "path",
    "commit_sha",
    "start",
    "end",
    "sha256",
    "language",
    "text",
    "valid_from",
    "embed_model"
  ],
  "properties": {
    "kind": { "enum": ["code.symbol", "code.file_slice"] },
    "repo": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "commit_sha": { "type": "string", "minLength": 7 },
    "start": { "type": "integer", "minimum": 1 },
    "end": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "minLength": 16 },
    "symbol_name": { "type": ["string", "null"] },
    "symbol_kind": {
      "type": ["string", "null"],
      "enum": ["function", "class", "method", "module", null]
    },
    "language": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "valid_from": { "type": "string", "minLength": 1 },
    "valid_to": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] },
    "embed_model": { "const": "voyage-code-3" }
  }
}
